generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Product {
  id      Int      @id @default(autoincrement())
  name    String
  price   Int
  reviews Review[]
}

model Review {
  id        Int     @id @default(autoincrement())
  rating    Int
  body      String
  productId Int
  product   Product @relation(fields: [productId], references: [id])
}
