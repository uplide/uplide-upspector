{
  "name": "@uplide/debugbar-next",
  "version": "0.1.0",
  "description": "Next.js App Router glue for @uplide/debugbar: SSR capture, render profiling and the element inspector route.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/with-debugbar.d.ts",
      "default": "./dist/with-debugbar.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./inspect": {
      "types": "./dist/inspect.d.ts",
      "default": "./dist/inspect.js"
    },
    "./mcp": {
      "types": "./dist/mcp.d.ts",
      "default": "./dist/mcp.js"
    },
    "./route": {
      "types": "./dist/route.d.ts",
      "default": "./dist/route.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@uplide/debugbar": "workspace:*",
    "jiti": "^2.7.0"
  },
  "peerDependencies": {
    "axios": "^1.7.0",
    "next": ">=15.3",
    "react": ">=19"
  },
  "peerDependenciesMeta": {
    "axios": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "axios": "^1.12.2",
    "react": "19.2.4"
  }
}
